{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avatarforge",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-16",
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
